---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppIcon from '../../../components/AppIcon.astro';
import AppStoreBadge from '../../../components/AppStoreBadge.astro';
import QrBlock from '../../../components/QrBlock.astro';
import FaqSection from '../../../components/FaqSection.astro';
import BlogPostCard from '../../../components/BlogPostCard.astro';
import { apps } from '../../../data/apps';
import { faq, faqJsonLd } from '../../../data/faq';
import { getCollection } from 'astro:content';

const app = apps.picolle;

const screenshots = [
  { src: '/images/picolle/ss-1.webp', alt: 'こどもの作品を小さな美術館に。作品が額縁つきで表示された画面' },
  { src: '/images/picolle/ss-2.webp', alt: '素敵な作品を写真アプリに埋もれさせない。個展の作品一覧画面' },
  { src: '/images/picolle/ss-3.webp', alt: 'AIが作品の素晴らしさを見つけてほめるお手伝い。AI学芸員ルゥのコメント画面' },
  { src: '/images/picolle/ss-4.webp', alt: '家族とアプリ内で作品を共有、SNSでシェア、制作日の年齢を表示、広告なし、Appleでサインイン' },
];

const steps = [
  { num: '1', title: '撮る', description: 'お子さまの作品をカメラで撮影', icon: 'ri-camera-line' },
  { num: '2', title: '飾る', description: '美術館風フレームで特別な一枚に', icon: 'ri-image-line' },
  { num: '3', title: '残す', description: '個展にまとめて家族で共有', icon: 'ri-heart-line' },
];

const features = [
  { icon: 'ri-magic-line', title: 'AI学芸員「ルゥ」', description: 'ハリネズミの学芸員ルゥが、作品の色や形、構図を見て感想を届けます。AIによるタイトル候補の提案にも対応しています。' },
  { icon: 'ri-cake-2-line', title: '制作時の年齢を自動記録', description: '登録したお子さまを選ぶだけで、制作日の年齢を自動計算。「3歳9ヶ月」のように成長の一瞬を作品と一緒に残せます。' },
  { icon: 'ri-group-line', title: '家族みんなで鑑賞', description: '個展ごとの招待リンクで家族に共有。無料プランでも5人まで、離れて暮らす家族と一緒に作品を楽しめます。' },
];

const targetUsers = [
  'お子さまの作品が増えてきて保管に困っている',
  '作品を捨てるのは忍びないけど、場所が足りない',
  'おじいちゃん・おばあちゃんに作品を見せたい',
  '成長記録として作品を残しておきたい',
];

const plans = [
  { name: 'Free', price: '無料', features: ['画質: 長辺2048px', '個展: 初回3個（毎月+1、上限10個）', '1個展あたり: 20作品', '個展共有: 5人まで', '画像シェア: 無制限'] },
  { name: 'Premium', price: '月額500円', features: ['画質: 長辺4096px', '個展: 最大50個', '1個展あたり: 100作品', '子ども単位の共有', '高画質画像: 長辺4096px'], recommended: true },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.app === 'picolle'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<AppLayout
  appId="picolle"
  landing
  title="Picolle.（ピコレ）- 子どもの絵・工作を美術館風に保存するアプリ | daywizz"
  description="Picolle.（ピコレ）は、子どもの絵や工作を撮るだけで美術館の「個展」にできるiPhoneアプリ。AI学芸員ルゥの感想、制作時の年齢記録、祖父母との家族共有。無料ではじめられます。"
  jsonLd={faqJsonLd(faq.picolle)}
>
  <!-- ヒーロー -->
  <section class="overflow-hidden bg-picolle-bg">
    <div class="container-site grid items-center gap-10 py-12 md:py-16 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <AppIcon app={app} size={60} />
          <div>
            <p class="text-sm font-bold text-picolle">{app.name}（ピコレ）</p>
            <p class="text-xs text-gray-600">{app.version} ・ {app.devices}</p>
          </div>
        </div>
        <h1 class="mt-6 text-4xl font-bold text-gray-900 md:text-5xl md:leading-tight">冷蔵庫に貼るだけじゃ、<br class="hidden sm:inline" />もったいない。</h1>
        <p class="mt-5 max-w-xl text-gray-700">{app.description}</p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="特長">
          <li class="chip"><i class="ri-price-tag-3-line text-picolle" aria-hidden="true"></i>無料ではじめられる</li>
          <li class="chip"><i class="ri-group-line text-picolle" aria-hidden="true"></i>家族5人まで共有</li>
          <li class="chip"><i class="ri-magic-line text-picolle" aria-hidden="true"></i>AI学芸員ルゥ</li>
          <li class="chip"><i class="ri-forbid-line text-picolle" aria-hidden="true"></i>広告なし</li>
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <AppStoreBadge app={app} campaign="lp_hero" size="lg" />
          <QrBlock app={app} />
        </div>
      </div>
      <div class="flex justify-center gap-4 lg:justify-end">
        <img src={screenshots[0].src} alt={screenshots[0].alt} width="640" height="1385" class="h-[420px] w-auto rounded-3xl shadow-xl ring-1 ring-black/5 sm:h-[500px]" fetchpriority="high" />
        <img src={screenshots[2].src} alt="" width="640" height="1385" class="mt-12 hidden h-[440px] w-auto rounded-3xl shadow-lg ring-1 ring-black/5 sm:block" />
      </div>
    </div>
  </section>

  <!-- スクリーンショット -->
  <section aria-label="スクリーンショット" class="py-12 md:py-16">
    <div class="container-site">
      <ul class="scrollbar-hide -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0 lg:justify-center">
        {screenshots.map((ss) => (
          <li class="shrink-0 snap-center">
            <img src={ss.src} alt={ss.alt} width="640" height="1385" class="h-[460px] w-auto rounded-2xl shadow-md ring-1 ring-black/5" loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3ステップ -->
  <section class="bg-picolle-bg py-14 md:py-20">
    <div class="container-site">
      <h2 class="section-title text-center">かんたん3ステップ</h2>
      <ol class="mx-auto mt-10 grid max-w-4xl gap-8 md:grid-cols-3">
        {steps.map((step) => (
          <li class="text-center">
            <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-picolle text-xl font-bold text-white" aria-hidden="true">{step.num}</span>
            <h3 class="mt-4 text-lg font-bold text-gray-900"><span class="sr-only">ステップ{step.num}：</span>{step.title}</h3>
            <p class="mt-1 text-gray-600">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 特徴 + こんな方に -->
  <section class="container-site grid gap-12 py-14 md:py-20 lg:grid-cols-[1.4fr_1fr]">
    <div>
      <h2 class="section-title">特徴</h2>
      <div class="mt-8 space-y-8">
        {features.map((f) => (
          <div class="flex gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-picolle-bg text-xl text-picolle"><i class={f.icon} aria-hidden="true"></i></span>
            <div>
              <h3 class="font-bold text-gray-900">{f.title}</h3>
              <p class="mt-1 text-[15px] leading-relaxed text-gray-600">{f.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="rounded-3xl bg-picolle-bg p-6 sm:p-8">
      <h2 class="text-xl font-bold text-gray-900">こんな方におすすめ</h2>
      <ul class="mt-5 space-y-3">
        {targetUsers.map((t) => (
          <li class="flex items-start gap-3 text-gray-700"><i class="ri-checkbox-circle-fill mt-0.5 shrink-0 text-lg text-picolle" aria-hidden="true"></i>{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- プラン -->
  <section aria-labelledby="plan-h" class="border-t border-gray-100 py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 id="plan-h" class="section-title text-center">プラン</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {plans.map((plan) => (
          <div class:list={['rounded-2xl border bg-white p-6 sm:p-8', plan.recommended ? 'border-picolle shadow-md ring-1 ring-picolle' : 'border-gray-200']}>
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-bold text-gray-900">{plan.name}</h3>
              {plan.recommended && <span class="rounded-full bg-picolle px-3 py-0.5 text-xs font-bold text-white">おすすめ</span>}
            </div>
            <p class="mt-1 text-3xl font-bold text-picolle">{plan.price}</p>
            <ul class="mt-5 space-y-2">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-gray-700"><i class="ri-check-line mt-0.5 shrink-0 text-picolle" aria-hidden="true"></i>{f}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-4 text-center text-xs text-gray-600">Premium の管理・解約は iPhone の「設定」> Apple ID > サブスクリプション から行えます。</p>
    </div>
  </section>

  <!-- 最新アップデート -->
  <section class="container-site pb-14 md:pb-20">
    <div class="rounded-3xl border border-gray-200 p-6 sm:p-10">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-picolle px-3 py-1 text-xs font-bold text-white">UPDATE</span>
        <span class="text-sm text-gray-600">{app.version} ・ 2026年7月5日</span>
      </div>
      <h2 class="mt-4 text-xl font-bold text-gray-900 md:text-2xl">作品が増えても、もっとサクサク</h2>
      <p class="mt-3 max-w-3xl text-gray-700">個展・作品・アーティスト一覧のデータ取得を見直し、読み込みを高速化しました。一度読み込んだ情報を活用するため、一覧と詳細を行き来するときもスムーズです。</p>
      <ul class="mt-5 flex flex-wrap gap-2">
        <li class="chip"><i class="ri-speed-up-line text-picolle" aria-hidden="true"></i>通信回数を削減</li>
        <li class="chip"><i class="ri-swap-line text-picolle" aria-hidden="true"></i>画面遷移を高速化</li>
        <li class="chip"><i class="ri-shield-check-line text-picolle" aria-hidden="true"></i>安定性を改善</li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section aria-labelledby="faq-h" class="border-t border-gray-100 py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 id="faq-h" class="section-title">よくある質問</h2>
      <div class="mt-6">
        <FaqSection items={faq.picolle.slice(0, 5)} openFirst />
      </div>
      <a href="/apps/picolle/support/" class="link-arrow mt-4 text-picolle">すべての質問・お問い合わせ<i class="ri-arrow-right-line" aria-hidden="true"></i></a>
    </div>
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="posts-h" class="container-site pb-14 md:pb-20">
      <h2 id="posts-h" class="text-xl font-bold text-gray-900">Picolle. の最新情報</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {posts.map((post) => (
          <BlogPostCard variant="card" title={post.data.title} date={post.data.pubDate} tags={post.data.tags} slug={post.id} excerpt={post.data.description} app={post.data.app} />
        ))}
      </div>
    </section>
  )}

  <!-- 最後の CTA -->
  <section class="bg-picolle text-white">
    <div class="container-site grid items-center gap-8 py-14 md:grid-cols-[1fr_auto]">
      <div>
        <h2 class="text-2xl font-bold md:text-3xl">お子さまの作品を、特別な思い出に。</h2>
        <p class="mt-2 text-white/85">無料ではじめられます。</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <AppStoreBadge app={app} campaign="lp_bottom" size="lg" inverse />
        <QrBlock app={app} inverse />
      </div>
    </div>
  </section>
</AppLayout>
