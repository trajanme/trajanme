---
interface Props { items: Array<{ question: string; answer: string }>; }
const { items } = Astro.props;
---
<div class="faq-list">{items.map(item => <details class="faq-item"><summary><span>{item.question}</span><span class="faq-plus" aria-hidden="true"></span></summary><div class="faq-answer"><p>{item.answer}</p></div></details>)}</div>
