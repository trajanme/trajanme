---
import { releasedApps } from '../data/apps';
const currentPath = Astro.url.pathname;
const links = [{ href: '/about/', label: 'daywizzについて' }, { href: '/blog/', label: '活動の足跡' }, { href: '/contact/', label: 'お問い合わせ' }];
const active = (href: string) => currentPath === href || (href === '/blog/' && currentPath.startsWith(href));
---
<header class="site-header">
  <div class="site-container header-inner">
    <a href="/" class="brand-link" aria-label="daywizz ホーム">
      <img src="/brand/daywizz-logo-white.svg" alt="daywizz" width="1875" height="520" />
    </a>
    <nav class="desktop-nav" aria-label="メインナビゲーション">
      <a href={links[0].href} aria-current={active(links[0].href) ? 'page' : undefined}>{links[0].label}</a>
      <details class="app-menu" data-nav-disclosure>
        <summary>アプリ <span class="chevron" aria-hidden="true"></span></summary>
        <div class="app-menu-panel">
          <p class="eyebrow">暮らしの中の、小さなきっかけ</p>
          {releasedApps.map(app => (
            <a href={`/apps/${app.id}/`} aria-current={currentPath === `/apps/${app.id}/` ? 'page' : undefined}>
              <img src={app.icon} alt="" width="40" height="40" />
              <span><strong>{app.name}</strong><small>{app.tagline}</small></span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
          <a class="coming-link" href="/apps/omiya/">omiya <small>準備中</small><span aria-hidden="true">↗</span></a>
        </div>
      </details>
      {links.slice(1).map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <details class="mobile-nav" data-nav-disclosure>
      <summary><span class="menu-label">メニュー</span><span class="menu-lines" aria-hidden="true"></span></summary>
      <nav class="mobile-nav-panel" aria-label="モバイルナビゲーション">
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>ホーム</a>
        <a href="/about/" aria-current={active('/about/') ? 'page' : undefined}>daywizzについて</a>
        <p class="eyebrow">アプリ</p>
        {releasedApps.map(app => <a href={`/apps/${app.id}/`} aria-current={currentPath.startsWith(`/apps/${app.id}/`) ? 'page' : undefined}><img src={app.icon} alt="" width="28" height="28" />{app.name}<span aria-hidden="true">↗</span></a>)}
        <a href="/apps/omiya/">omiya <small>準備中</small></a>
        {links.slice(1).map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
<script>
  const disclosures = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-disclosure]')];
  const closeMenus = () => disclosures.forEach(menu => { menu.open = false; });
  disclosures.forEach(menu => {
    menu.addEventListener('toggle', () => {
      if (menu.open) disclosures.forEach(other => { if (other !== menu) other.open = false; });
    });
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) {
        event.preventDefault(); menu.open = false; menu.querySelector('summary')?.focus();
      }
    });
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenus));
    menu.addEventListener('focusout', event => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    });
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node) disclosures.forEach(menu => { if (!menu.contains(event.target as Node)) menu.open = false; });
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', closeMenus);
</script>
