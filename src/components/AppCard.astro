---
import type { Platform } from '../data/apps';
interface Props { name: string; tagline: string; color: string; href: string; platforms: Platform[]; icon: string; version?: string; }
const { name, tagline, href, platforms, icon, version } = Astro.props;
const walking = name === 'PawSteps';
---
<a href={href} class="product-card">
  <div class="product-card-media">
    {walking ? <img class="product-dog" src="/images/pawsteps-corgi.png" alt="PawStepsのコーギーキャラクター" width="200" height="200" loading="lazy" /> : <img class="product-screen" src="/images/picolle-ss-1.png" alt="Picolle.の個展画面" width="180" height="390" loading="lazy" />}
    <span class="product-card-category">{walking ? '楽しめる体をつくる' : '地域で育つ力を伸ばす'}</span>
  </div>
  <div class="product-card-content"><div class="product-card-title">{icon && <img src={icon} alt="" width="48" height="48" loading="lazy" />}<div><h3>{name}</h3><span class="product-meta">{platforms.join(' / ')}{version && ` · ${version}`}</span></div><span class="product-arrow" aria-hidden="true">↗</span></div><p>{tagline}</p><span class="text-link">詳しく見る <span aria-hidden="true">→</span></span></div>
</a>
