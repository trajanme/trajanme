---
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
  /** 最初の項目を開いた状態で表示 */
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="divide-y divide-gray-200 border-y border-gray-200">
  {items.map((item, index) => (
    <details id={item.id} class="group scroll-mt-24" open={openFirst && index === 0}>
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <i class="ri-add-line shrink-0 text-xl text-gray-500 transition-transform group-open:rotate-45" aria-hidden="true"></i>
      </summary>
      <p class="pb-5 pr-8 text-[15px] leading-relaxed text-gray-600">{item.answer}</p>
    </details>
  ))}
</div>

<script>
  // /support/#id で来たら該当の質問を開く
  const open = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id ? document.getElementById(id) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  open();
  window.addEventListener('hashchange', open);
</script>
