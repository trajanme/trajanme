---
import BaseLayout from './BaseLayout.astro';
import { apps } from '../data/apps';

interface Props {
  appId: string;
}

const { appId } = Astro.props;
const app = apps[appId];

if (!app) {
  return Astro.redirect('/404/');
}

const basePath = `/apps/${appId}`;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'トップ', href: `${basePath}/` },
  ...(app.pages.support ? [{ label: 'サポート', href: `${basePath}/support/` }] : []),
  ...(app.pages.privacy ? [{ label: 'プライバシーポリシー', href: `${basePath}/privacy/` }] : []),
  ...(app.pages.terms ? [{ label: '利用規約', href: `${basePath}/terms/` }] : []),
  ...(app.pages.tokushoho ? [{ label: '特定商取引法に基づく表記', href: `${basePath}/tokushoho/` }] : []),
];
---

<BaseLayout title={`${app.name} - daywizz`} description={app.description}>
  <div class="product-shell">
    <nav class="app-subnav" aria-label={`${app.name} のナビゲーション`}>
      <div class="site-container app-subnav-inner">
        <a class="app-identity" href={`${basePath}/`}>{app.icon && <img src={app.icon} alt="" width="28" height="28" />}<strong>{app.name}</strong></a>
        <div class="app-subnav-links">{navItems.map(item => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}</div>
      </div>
    </nav>
    <slot />
  </div>
</BaseLayout>
