---
import { releasedApps } from '../data/apps';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label="daywizz ホーム"><img src="/brand/daywizz-logo-white.svg" alt="daywizz" width="1875" height="520" /></a>
        <p>地域に、ちいさな魔法を。</p>
        <small>土地と、そこに暮らす人が主役。<br />日々の小さなきっかけを、続く仕組みに。</small>
      </div>
      <nav aria-label="フッターナビゲーション">
        <h2>daywizz</h2>
        <a href="/about/">私たちについて</a><a href="/blog/">活動の足跡</a><a href="/contact/">お問い合わせ</a>
      </nav>
      <nav aria-label="アプリ一覧">
        <h2>アプリ</h2>
        {releasedApps.map(app => <a href={`/apps/${app.id}/`}>{app.name}<span aria-hidden="true">↗</span></a>)}
        <a href="/apps/omiya/">omiya <small>準備中</small></a>
      </nav>
      <nav aria-label="外部リンク">
        <h2>つながる</h2>
        <a href="https://x.com/shin_daywizz" target="_blank" rel="noopener noreferrer">X<span class="sr-only">（新しいタブ）</span><span aria-hidden="true">↗</span></a>
        <a href="https://github.com/trajanme" target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only">（新しいタブ）</span><span aria-hidden="true">↗</span></a>
        <a href="https://note.com/shin_daywizz" target="_blank" rel="noopener noreferrer">note<span class="sr-only">（新しいタブ）</span><span aria-hidden="true">↗</span></a>
      </nav>
    </div>
    <div class="footer-bottom"><small>© {year} daywizz</small><span>土地と灯り / A little magic for every corner of Japan.</span><a href="#main-content">ページの先頭へ ↑</a></div>
  </div>
</footer>
