---
const path = Astro.url.pathname;

const navItems = [
  { label: 'アプリ', href: '/apps/', match: (p: string) => p.startsWith('/apps/') && !p.endsWith('/support/') },
  { label: 'サポート', href: '/support/', match: (p: string) => p.startsWith('/support/') || p.endsWith('/support/') },
  { label: 'ブログ', href: '/blog/', match: (p: string) => p.startsWith('/blog/') },
  { label: '運営者', href: '/about/', match: (p: string) => p.startsWith('/about/') },
];
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" class="font-brand text-2xl leading-none text-gray-800 hover:opacity-80" aria-label="daywizz トップへ">daywizz</a>

    <nav aria-label="メイン" class="hidden items-center gap-1 text-sm font-medium md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={item.match(path) ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-11 items-center rounded-full px-4 transition-colors',
            item.match(path) ? 'bg-gray-100 text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact/"
        class="ml-2 inline-flex min-h-11 items-center rounded-full border border-gray-300 px-5 text-gray-800 transition-colors hover:border-gray-800"
      >
        お問い合わせ
      </a>
    </nav>

    <button
      type="button"
      id="mobile-menu-btn"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-full text-gray-700 hover:bg-gray-100 md:hidden"
      aria-label="メニュー"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <i class="ri-menu-line text-xl" id="menu-icon" aria-hidden="true"></i>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="メイン（モバイル）" class="hidden border-t border-gray-100 bg-white md:hidden">
    <ul class="container-site flex flex-col py-2 text-base font-medium">
      {navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={item.match(path) ? 'page' : undefined} class="flex min-h-12 items-center justify-between border-b border-gray-50 text-gray-800">
            {item.label}
            <i class="ri-arrow-right-s-line text-gray-400" aria-hidden="true"></i>
          </a>
        </li>
      ))}
      <li>
        <a href="/contact/" class="flex min-h-12 items-center justify-between text-gray-800">
          お問い合わせ
          <i class="ri-arrow-right-s-line text-gray-400" aria-hidden="true"></i>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  btn?.addEventListener('click', () => {
    const willOpen = menu?.classList.contains('hidden') ?? false;
    menu?.classList.toggle('hidden', !willOpen);
    btn.setAttribute('aria-expanded', String(willOpen));
    icon?.classList.toggle('ri-menu-line', !willOpen);
    icon?.classList.toggle('ri-close-line', willOpen);
  });
</script>
