---
import type { AppInfo } from '../data/apps';

interface Props {
  app: AppInfo;
  /** CSS px */
  size?: number;
  class?: string;
  /** 装飾として使う場合は true（alt を空に） */
  decorative?: boolean;
}

const { app, size = 64, class: className, decorative = false } = Astro.props;
---

<img
  src={app.icon}
  alt={decorative ? '' : `${app.name} アプリアイコン`}
  width={size}
  height={size}
  class:list={['shrink-0 rounded-[22%] ring-1 ring-black/5 shadow-sm', className]}
  style={`width:${size}px;height:${size}px`}
  loading="lazy"
/>
