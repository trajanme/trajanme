---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSupport from '../../../components/AppSupport.astro';
import { apps } from '../../../data/apps';
import { faq, faqJsonLd } from '../../../data/faq';

const app = apps.pawsteps;
const items = faq.pawsteps;
---

<AppLayout
  appId="pawsteps"
  title="PawSteps サポート・よくある質問 | daywizz"
  description="PawSteps（犬と歩く歩数計）のよくある質問。歩数の記録方法、Apple Watch、料金、機種変更時のデータについて。"
  jsonLd={faqJsonLd(items)}
>
  <AppSupport app={app} items={items} />
</AppLayout>
