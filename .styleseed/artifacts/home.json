{
  "schemaVersion": 1,
  "id": "home",
  "target": {
    "kind": "route",
    "locator": "/"
  },
  "selection": {
    "grammar": "expressive-marketing",
    "adapter": "product-ui",
    "domain": "content",
    "page": "landing",
    "recipe": "expressive-brand",
    "palette": null,
    "profile": "none",
    "fallback": "expressive-marketing"
  },
  "decisions": {
    "primaryDecision": "Understand daywizz and decide whether its actual offering is relevant.",
    "primaryAction": "Explore the actual products and regional mission.",
    "signatureMove": "土地と灯り: calm kinari and forest framing, genuine product evidence, and one akari emphasis per screen."
  },
  "implementation": {
    "sourceRoots": [
      "src/pages/index.astro",
      "src/components",
      "src/layouts",
      "src/styles",
      "src/data",
      "public/brand",
      "public/images",
      "astro.config.mjs",
      "package.json",
      "src/lib",
      "test",
      "package-lock.json",
      "scripts/sync-styleseed-spacing.mjs",
      "scripts/sample-logo-particles.mjs"
    ],
    "tokenFiles": [
      "src/styles/global.css",
      "design/brand/tokens.json",
      "design/brand/tokens.css",
      "design/brand/components.css"
    ]
  },
  "validation": {
    "scoreFloor": 80,
    "requiredRenders": [
      {
        "id": "mobile-loaded",
        "state": "loaded",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "desktop-loaded",
        "state": "loaded",
        "viewport": {
          "width": 1440,
          "height": 900
        }
      }
    ],
    "temporal": {
      "required": true,
      "scenarios": [
        "background-pause-resume",
        "background-reduced-motion",
        "background-out-of-view"
      ]
    },
    "humanAcceptance": true,
    "functional": {
      "scenarios": [
        "navigation-targets-exist",
        "route-artifact-mapping",
        "background-animation-pause-policy",
        "particle-field-fits-responsive-viewports",
        "particle-shapes-morph-continuously",
        "logo-hold-preserves-source-artwork",
        "river-flows-downstream-faster-than-mountains"
      ]
    }
  }
}
