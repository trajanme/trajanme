  "implementation": {
    "sourceRoots": [
      "src/pages/apps/omiya/index.astro",
      "src/components",
      "src/layouts",
      "src/styles",
      "src/data",
      "public/brand",
      "public/images",
      "astro.config.mjs",
      "package.json",
      "src/lib",
      "test",
      "package-lock.json",
      "scripts/sync-styleseed-spacing.mjs"
    ],
    "tokenFiles": [
      "src/styles/global.css",
      "design/brand/tokens.json",
      "design/brand/tokens.css",
      "design/brand/components.css"
    ]
  },
  "validation": {
    "scoreFloor": 80,
    "requiredRenders": [
      {
        "id": "mobile-loaded",
        "state": "loaded",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "desktop-loaded",
        "state": "loaded",
        "viewport": {
          "width": 1440,
          "height": 900
