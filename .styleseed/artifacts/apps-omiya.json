{
  "schemaVersion": 1,
  "id": "apps-omiya",
  "target": {
    "kind": "route",
    "locator": "/apps/omiya/"
  },
  "selection": {
    "grammar": "expressive-marketing",
    "adapter": "product-ui",
    "domain": "content",
    "page": "landing",
    "recipe": "expressive-brand",
    "palette": null,
    "profile": "none",
    "fallback": "expressive-marketing"
  },
  "decisions": {
    "primaryDecision": "Understand omiya and decide whether its actual offering is relevant.",
