---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSupport from '../../../components/AppSupport.astro';
import { apps } from '../../../data/apps';
import { faq, faqJsonLd } from '../../../data/faq';

const app = apps.picolle;
const items = faq.picolle;
---

<AppLayout
  appId="picolle"
  title="Picolle. サポート・よくある質問 | daywizz"
  description="Picolle.（ピコレ）のよくある質問。家族との共有、画質、個展の上限、Premiumの解約、機種変更、アカウント削除について。"
  jsonLd={faqJsonLd(items)}
>
  <AppSupport app={app} items={items} />
</AppLayout>
