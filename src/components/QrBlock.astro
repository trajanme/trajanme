---
import type { AppInfo } from '../data/apps';

interface Props {
  app: AppInfo;
  inverse?: boolean;
}

const { app, inverse = false } = Astro.props;
---

{app.qr && (
  <div class="hidden items-center gap-3 lg:flex">
    <img
      src={app.qr}
      alt={`${app.name} の App Store ページを開くQRコード`}
      width="88"
      height="88"
      class="h-22 w-22 rounded-xl bg-white p-1.5 ring-1 ring-black/10"
      loading="lazy"
    />
    <p class:list={['text-xs leading-relaxed', inverse ? 'text-white/85' : 'text-gray-600']}>
      PCでご覧の方は<br />iPhoneのカメラで<br />読み取ってください
    </p>
  </div>
)}
