---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import ParticleLandscape from '../components/ParticleLandscape.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import { releasedApps } from '../data/apps';
import { getCollection } from 'astro:content';
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);
---
<BaseLayout title="daywizz — 地域に、ちいさな魔法を。" description="日本各地の魅力に光を当て、地域がにぎわい続ける仕組みをつくる。暮らしに寄り添うアプリと、IT・業務の仕組みづくりに取り組むdaywizzです。">
  <section class="hero-scene" aria-labelledby="home-title">
    <div class="hero-photo" aria-hidden="true"><img src="/images/hero-katsura.webp" alt="" width="1000" height="750" fetchpriority="high" decoding="async" /></div>
    <ParticleLandscape />
    <div class="home-hero site-container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span>暮らしから、地域へ。</p>
      <h1 id="home-title">地域に、<br />ちいさな魔法を。</h1>
      <p class="hero-lead">訪れる人に、土地の魅力を。<br />暮らす人に、毎日の楽しみを。<br />そこで育つ子に、広がる可能性を。</p>
      <p class="hero-description">身近な暮らしに寄り添うアプリと、<br class="desktop-break" />IT・業務の仕組みづくりから始めています。</p>
      <div class="hero-actions"><a href="#apps" class="button button-primary">アプリを見る <span aria-hidden="true">↓</span></a><a href="/about/" class="text-link">daywizzについて <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-dot-stage" aria-hidden="true"></div>
    </div>
  </section>
  <p class="hero-photo-credit site-container">背景写真：<a href="https://commons.wikimedia.org/wiki/File:Katsura_River_at_Arashiyama.jpg">京都・嵐山 / Nicholas Graves (NickAura)</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>（トリミング・生成りのフェードを追加）</p>

  <section class="mission-section" aria-labelledby="mission-title">
    <div class="site-container mission-inner"><p class="eyebrow">大切にしていること</p><div><h2 id="mission-title">主役は、土地とそこに暮らす人。</h2><p>日本各地の魅力に光を当て、地域がにぎわい続ける仕組みをつくる。<br class="desktop-break" />まずは拠点のある関西から、小さく始めて、続く形を育てていきます。</p></div><a href="/about/" class="text-link">私たちの思い <span aria-hidden="true">↗</span></a></div>
  </section>

  <section id="apps" class="section-space site-container" aria-labelledby="apps-title">
    <div class="section-heading"><div><p class="eyebrow">暮らしに寄り添うアプリ</p><h2 id="apps-title">いつもの毎日に、<br class="mobile-break" />新しいきっかけを。</h2></div><p>自分や家族の「こうだったらいいのに」から<br class="desktop-break" />生まれたプロダクトです。</p></div>
    <div class="product-grid">{releasedApps.map(app => <AppCard name={app.name} tagline={app.tagline} color={app.color} href={`/apps/${app.id}/`} platforms={app.platforms} icon={app.icon} version={app.version} />)}</div>
    <a href="/apps/omiya/" class="upcoming-row"><span class="status-label">準備中</span><strong>omiya</strong><span>日本のおみやげ文化を世界へ</span><span aria-hidden="true">↗</span></a>
  </section>

  <section class="journal-section section-space" aria-labelledby="journal-title"><div class="site-container">
    <div class="section-heading"><div><p class="eyebrow">日々の取り組みを、少しずつ</p><h2 id="journal-title">活動の足跡</h2></div><a href="/blog/" class="text-link">すべての記事 <span aria-hidden="true">↗</span></a></div>
    {latestPosts.length > 0 ? <div class="journal-list">{latestPosts.map(post => <BlogPostCard title={post.data.title} date={post.data.pubDate} tags={post.data.tags} slug={post.id} excerpt={post.data.description} />)}</div> : <p class="empty-state">日々の取り組みを、これから少しずつお届けします。</p>}
  </div></section>

  <section class="section-space site-container"><div class="contact-band"><div><p class="eyebrow">一緒に、できることを。</p><h2>地域や暮らしの「困った」を、<br />話すところから。</h2><p>アプリのご質問も、IT・業務のご相談も。<br />まずはお気軽にお聞かせください。</p></div><a href="/contact/" class="button button-on-forest">お問い合わせ <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
