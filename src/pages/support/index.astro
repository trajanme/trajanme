---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import { releasedApps, apps, appPageKeys, type AppPageKey } from '../../data/apps';
import { faq } from '../../data/faq';

const legalLabels: Partial<Record<AppPageKey, string>> = {
  privacy: 'プライバシーポリシー',
  terms: '利用規約',
  tokushoho: '特定商取引法に基づく表記',
};
const contactEmail = apps.picolle.contactEmail;
---

<BaseLayout title="サポート - daywizz" description="daywizz のアプリ（Picolle.・PawSteps）のよくある質問、解約・機種変更・データの扱い、お問い合わせ先をまとめています。">
  <section class="bg-gray-50">
    <div class="container-site py-12 md:py-16">
      <h1 class="text-3xl font-bold text-gray-900 md:text-4xl">サポート</h1>
      <p class="mt-3 text-gray-600">お使いのアプリを選んでください。よくある質問から順に並べています。</p>
    </div>
  </section>

  <section class="container-site grid gap-6 py-12 md:grid-cols-2">
    {releasedApps.map((app) => (
      <article class="card flex flex-col p-6 sm:p-8">
        <h2 class="flex items-center gap-3 text-xl font-bold text-gray-900">
          <AppIcon app={app} size={48} decorative />
          {app.name} のヘルプ
        </h2>
        <ul class="mt-6 divide-y divide-gray-100 border-y border-gray-100">
          {faq[app.id].map((q) => (
            <li>
              <a href={`/apps/${app.id}/support/#${q.id}`} class="flex min-h-12 items-center justify-between gap-3 py-2 text-[15px] text-gray-800 hover:underline">
                {q.question}
                <i class="ri-arrow-right-s-line shrink-0 text-gray-400" aria-hidden="true"></i>
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {appPageKeys(app, ['privacy', 'terms', 'tokushoho']).map((key) => (
              <li><a href={`/apps/${app.id}/${key}/`} class="inline-flex min-h-10 items-center underline-offset-4 hover:underline" style={`color: var(--color-${app.color})`}>{legalLabels[key]}</a></li>
            ))}
        </ul>
      </article>
    ))}
  </section>

  <section class="container-site pb-16">
    <div class="grid gap-6 rounded-3xl bg-gray-900 p-8 text-white sm:p-10 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 class="text-xl font-bold">解決しないときは、メールでお問い合わせください</h2>
        <p class="mt-3 text-sm leading-relaxed text-gray-300">
          通常2営業日以内にお返事します。お問い合わせの際は、<strong class="text-white">アプリ名・ご利用端末・iOSのバージョン・アプリのバージョン・症状</strong>を添えていただくとスムーズです。
        </p>
      </div>
      <a href={`mailto:${contactEmail}`} class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-white px-6 font-bold text-gray-900 hover:bg-gray-100">
        <i class="ri-mail-line" aria-hidden="true"></i>{contactEmail}
      </a>
    </div>
  </section>
</BaseLayout>
